# 後台管理密碼（正式環境必填，未設定會停用後台登入；開發環境未設定時預設為 admin）
ADMIN_PASSWORD=qwe123qwe
# 選填：session 簽章密鑰，未設定時由 ADMIN_PASSWORD 推導
ADMIN_SESSION_SECRET=

# 選填：Cloudflare R2。五個都設定才會啟用，否則內容與圖片存在本機 data/ 資料夾
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2 bucket 的公開網址（自訂網域或 r2.dev），例如 https://media.example.com
R2_PUBLIC_URL=

# 選填：本機儲存資料夾位置（預設為專案根目錄的 data/）
CONTENT_DATA_DIR=
